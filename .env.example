# Copy to .env and adjust. All settings are HORUS_* env vars — see src/horus/config.py.

# Postgres from docker-compose (host port 5435). SQLite also works, e.g. for a demo:
# HORUS_DATABASE_URL=sqlite:///data/demo.db
HORUS_DATABASE_URL=postgresql+psycopg://horus:horus@localhost:5435/horus

# Collection centre/radius (defaults: Singapore, 250 nm — the adsb.lol cap).
# HORUS_ADSB_CENTER_LAT=1.35
# HORUS_ADSB_CENTER_LON=103.82
# HORUS_ADSB_RADIUS_NM=250
# HORUS_ADSB_POLL_SECONDS=30

# Optional OpenSky one-shot research cross-check only (never the operational collector).
# Anonymous latest-state access works without these; OAuth raises the research quota.
# HORUS_OPENSKY_CLIENT_ID=
# HORUS_OPENSKY_CLIENT_SECRET=
